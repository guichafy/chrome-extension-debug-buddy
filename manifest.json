{
  "name": "Network Request Interceptor",
  "description": "Intercept and log network requests based on URL patterns",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Network Request Interceptor",
    "default_icon": {
      "64": "images/icon_64px.png",
      "56": "images/icon_56px.png",
      "48": "images/icon_48px.png",
      "40": "images/icon_40px.png",
      "32": "images/icon_32px.png"
    }
  },
  "options_page": "main.html",
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "images/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
