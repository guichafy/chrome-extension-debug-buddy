{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignore": [
			"dist/**",
			"node_modules/**",
			"coverage/**",
			"lib/**",
			"images/**",
			"package-lock.json",
			"**/codemirror.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always",
			"jsxQuoteStyle": "double"
		}
	},
	"organizeImports": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off",
				"noConsoleLog": "off"
			},
			"style": {
				"useTemplate": "off",
				"noUselessElse": "off",
				"noNonNullAssertion": "off",
				"useImportType": "off"
			},
			"complexity": {
				"noUselessFragments": "off",
				"useOptionalChain": "off",
				"noForEach": "off"
			},
			"correctness": {
				"noUnusedVariables": "off",
				"noUnusedImports": "off",
				"useExhaustiveDependencies": "warn"
			},
			"a11y": {
				"useKeyWithClickEvents": "off"
			}
		}
	},
	"overrides": [
		{
			"include": ["**/__tests__/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useButtonType": "off",
						"useValidAnchor": "off"
					}
				}
			}
		}
	]
}
