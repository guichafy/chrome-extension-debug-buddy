		],
		"dom": [
			"img[data-src*='.bigcommerce.com'], img[src*='.bigcommerce.com'], link[href*='.bigcommerce.com']"
		],
		"js": {
			"bigcommerce_config": "",
			"bigcommerce_i18n": ""
		},
		"meta": {
			"platform": "^bigcommerce"
		},
		"scriptSrc": [
			"(?:\\.|plugins/)?bigcommerce(?:\\.com)?/(?:assets)?"
		],
