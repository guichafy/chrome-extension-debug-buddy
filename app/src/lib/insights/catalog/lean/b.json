			"js\\.braintreegateway\\.com"
		]
	},
	"Bootstrap": {
		"cats": [
			66
		],
		"dom": {
			"body[data-bs-theme]": {
				"attributes": {
					"data-bs-theme": "^(.*)$"
				}
			},
			"link[href*=\"cdn.jsdelivr.net/npm/bootstrap\"]": {
				"attributes": {
					"href": "bootstrap@([\\d.]+)"
				}
			},
			"style": {
				"text": "--bs-(?:gutter|emphasis|space-x|tertiary-bg|secondary-color)"
			}
		},
		"js": {
			"bootstrap.Alert": "",
			"bootstrap.Alert.VERSION": "^(.+)$\\;version:\\1",
			"jQuery.fn.tooltip.Constructor.VERSION": "^(.+)$\\;version:\\1"
		},
		"html": [
			"<style>\\s+/\\*!\\s+\\* Bootstrap v(\\d\\.\\d\\.\\d)\\;version:\\1",
			"<link[^>]* href=[^>]*?bootstrap(?:[^>]*?([0-9a-fA-F]{7,40}|[\\d]+(?:.[\\d]+(?:.[\\d]+)?)?)|)[^>-]*?(?:\\.min)?\\.css\\;version:\\1"
		],
		"scriptSrc": [
			"bootstrap(?:[^>]*?([0-9a-fA-F]{7,40}|[\\d]+(?:.[\\d]+(?:.[\\d]+)?)?)|)[^>]*?(?:\\.min)?\\.js\\;version:\\1"
		]
	},
	"Bulma": {
		"cats": [
			66
		],
		"dom": {
			"link[href*='bulma']": {
				"attributes": {
					"href": "(?:([\\d\\.]+)/css/)?bulma(?:-docs)?\\.min\\.css\\;version:\\1"
				}
			}
		},
		"js": {
			"Bulma.VERSION": "([\\d\\.]+)\\;version:\\1"
		}
	}
