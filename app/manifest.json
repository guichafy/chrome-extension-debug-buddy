{
  "name": "Debug Buddy",
  "short_name": "DbgBuddy",
  "description": "Intercept and log network requests based on URL patterns. Modify responses and create mocks for web development.",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "images/icon_16px.png",
    "32": "images/icon_32px.png",
    "48": "images/icon_48px.png",
    "64": "images/icon_64px.png",
    "128": "images/icon_128px.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Network Request Interceptor",
    "default_icon": {
      "16": "images/icon_16px.png",
      "32": "images/icon_32px.png",
      "48": "images/icon_48px.png",
      "64": "images/icon_64px.png",
      "128": "images/icon_128px.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "author": "Chafy Studio",
  "homepage_url": "https://github.com/Chafy-Studio/chrome-interceptor"
}
