{
  "name": "Debug Buddy",
  "short_name": "DbgBuddy",
  "description": "Inspect, intercept, and mock HTTP responses in Chrome to test how your app handles network failures without touching the backend.",
  "version": "0.13.0",
  "manifest_version": 3,
  "icons": {
    "16": "images/icon_16px.png",
    "32": "images/icon_32px.png",
    "48": "images/icon_48px.png",
    "64": "images/icon_64px.png",
    "128": "images/icon_128px.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "sidePanel",
    "offscreen",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Network Request Interceptor",
    "default_icon": {
      "16": "images/icon_16px.png",
      "32": "images/icon_32px.png",
      "48": "images/icon_48px.png",
      "64": "images/icon_64px.png",
      "128": "images/icon_128px.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "probe-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "probe-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rrweb-recorder.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "author": "Chafy Studio",
  "homepage_url": "https://github.com/guichafy/chrome-extension-debug-buddy"
}
