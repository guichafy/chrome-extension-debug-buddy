{
  "name": "debug-buddy",
  "version": "0.13.6",
  "type": "module",
  "description": "Create API mocks and troubleshoot web apps: inspect network calls, simulate failures, replay sessions and reproduce API errors.",
  "main": "background.js",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "devtools": "npx --yes react-devtools@8.0.0",
    "dev": "vite",
    "watch": "vite build --watch",
    "watch:dev": "vite build --watch --mode development",
    "clean": "rm -rf dist",
    "shadcn:add": "npx shadcn@latest add",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "catalog:rebuild": "tsx scripts/build-tech-catalog.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "lint": "biome check src e2e",
    "lint:fix": "biome check --write src e2e",
    "lint:ext": "node scripts/validate-extension.mjs",
    "format": "biome format --write src e2e",
    "typecheck": "tsc --noEmit",
    "typecheck:performance": "tsc --noEmit --project tsconfig.performance.json",
    "perf": "playwright test --config playwright.performance.config.ts --retries=0",
    "perf:smoke": "npm run perf -- recording.spec.ts --grep \"gravação real\"",
    "perf:soak": "PERF_SOAK=1 playwright test --config playwright.performance.config.ts --retries=0",
    "package": "node scripts/publish-cws.mjs --dry-run",
    "publish:cws": "node scripts/publish-cws.mjs",
    "prepare": "cd .. && husky",
    "docs:screenshots": "npm run build && playwright test -c playwright.docs.config.ts"
  },
  "lint-staged": {
    "{src,e2e}/**/*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "keywords": [
    "chrome",
    "extension",
    "network",
    "interceptor"
  ],
  "author": "Chafy Studio",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-table": "^8.21.2",
    "@types/uuid": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "glob": "^14.0.2",
    "i18next": "26.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.503.0",
    "lz-string": "^1.5.0",
    "microdiff": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "17.0.16",
    "react-router-dom": "^7.12.0",
    "rrweb": "^2.0.0-alpha.18",
    "rrweb-player": "^2.0.0-alpha.18",
    "source-map": "^0.7.6",
    "tailwind-merge": "^2.2.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.254",
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "archiver": "^7.0.1",
    "chrome-webstore-upload-cli": "^3.5.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "devtools-protocol": "^0.0.1624250",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^15.5.2",
    "playwright": "^1.59.1",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "vite-plugin-static-copy": "^2.3.2",
    "vitest": "^4.1.12",
    "web-ext": "^10.1.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "brace-expansion@1": "^1.1.13",
    "brace-expansion@2": "^2.0.3",
    "esbuild": "^0.25.0",
    "flatted": "^3.4.2",
    "form-data": "^4.0.4",
    "lodash": "^4.18.0",
    "minimatch@<10": "^9.0.7",
    "minimatch@>=10": "^10.2.3",
    "picomatch@<3": "^2.3.2",
    "picomatch@>=4": "^4.0.4",
    "postcss": "^8.5.12",
    "rollup": "^4.59.0",
    "uuid": "^14.0.0",
    "yaml": "^2.8.3"
  }
}
